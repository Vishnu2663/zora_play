# Build-time only: used by scripts/bedrock-*.mjs. The app itself never reads these and never calls AWS.
# Copy to your shell profile or export them. Never put real keys in this file.

# Credentials: use ONE of these (the normal AWS chain)
AWS_PROFILE=zora-play
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Region where you have Bedrock model access (we used ap-south-1)
AWS_REGION=ap-south-1

# Model id or inference profile id (we used Nova Lite; Nova Pro for jokes)
BEDROCK_MODEL_ID=apac.amazon.nova-lite-v1:0

# The child-safety guardrail (see scripts/bedrock-guardrail-setup.md). Use a numbered version, not DRAFT.
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=1

# Windows + Git Bash only: stop Git Bash rewriting /aws/... arguments for the AWS CLI
# MSYS_NO_PATHCONV=1
