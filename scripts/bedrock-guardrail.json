{
  "name": "zora-play-kids",
  "description": "Child-safety check for Zora Play build-time content (ages 3-8)",
  "topicPolicyConfig": {
    "topicsConfig": [
      {
        "name": "ScaryContent",
        "definition": "Anything frightening to a young child: monsters, ghosts, nightmares, dark places, being lost or hurt.",
        "examples": [
          "a monster under the bed",
          "the ghost will get you"
        ],
        "type": "DENY"
      },
      {
        "name": "Romance",
        "definition": "Dating, kissing, love between adults or teens.",
        "examples": [
          "kiss me",
          "my girlfriend"
        ],
        "type": "DENY"
      },
      {
        "name": "MedicalAdvice",
        "definition": "Illness, medicine, doctors, treatment, diagnosis.",
        "examples": [
          "take this pill",
          "you have a fever"
        ],
        "type": "DENY"
      },
      {
        "name": "PoliticsAndReligion",
        "definition": "Elections, parties, politicians, religious teaching.",
        "examples": [
          "vote for",
          "pray to"
        ],
        "type": "DENY"
      },
      {
        "name": "BrandsAndShopping",
        "definition": "Named products, brands, shops, ads, buying things.",
        "examples": [
          "buy this toy",
          "visit our shop"
        ],
        "type": "DENY"
      },
      {
        "name": "PersonalDataRequests",
        "definition": "Asking a child for name, age, address, school, photos or phone.",
        "examples": [
          "what is your address",
          "tell me your name"
        ],
        "type": "DENY"
      },
      {
        "name": "RealPeople",
        "definition": "Naming real celebrities, public figures or private people.",
        "examples": [
          "as said by a famous singer"
        ],
        "type": "DENY"
      }
    ]
  },
